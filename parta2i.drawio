<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="q2i" name="Question 2(i) - Band Influences"><mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0" background="#111111"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="QUESTION 2(i) — BAND INFLUENCES" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=#111111;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="28" width="1050" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Recursive UML association: a band is influenced by other bands." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=#111111;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="70" width="1050" height="28" as="geometry"/></mxCell><mxCell id="band" value="&lt;table style=&quot;border-collapse:collapse;width:100%;background:#111111;color:#ffffff;font-family:Arial;font-size:14px;text-align:center;border:1px solid #ffffff&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#6FA8DC;color:#111111;border:1px solid #ffffff;padding:9px&quot;&gt;&lt;b&gt;Band&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#111111;color:#ffffff;border:1px solid #ffffff;padding:7px&quot;&gt;&lt;u&gt;bandName&lt;/u&gt; (PK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#111111;color:#ffffff;border:1px solid #ffffff;padding:7px&quot;&gt;formedCity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#111111;color:#ffffff;border:1px solid #ffffff;padding:7px&quot;&gt;dateFormed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#111111;color:#ffffff;border:1px solid #ffffff;padding:7px&quot;&gt;dateEnded (optional)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rect;html=1;whiteSpace=wrap;overflow=fill;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="300" height="200" as="geometry"/></mxCell><mxCell id="influence" value="influences / is influenced by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFFFFF;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=13;labelBackgroundColor=#111111;endArrow=none;startArrow=none;exitX=1;exitY=0.2;entryX=1;entryY=0.8;" edge="1" parent="1" source="band" target="band"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="340"/><mxPoint x="900" y="475"/></Array></mxGeometry></mxCell><mxCell id="influencingMultiplicity" value="0..*" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=#111111;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="325" width="55" height="26" as="geometry"/></mxCell><mxCell id="influencedMultiplicity" value="0..*" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=#111111;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="480" width="55" height="26" as="geometry"/></mxCell><mxCell id="role1" value="Influencing band" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=#111111;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="295" width="150" height="25" as="geometry"/></mxCell><mxCell id="role2" value="Influenced band" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=#111111;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="505" width="150" height="25" as="geometry"/></mxCell><mxCell id="note" value="A band may have one or more influencing bands (zero or more in the database, since a band need not have recorded influences). A band may influence zero or many othe