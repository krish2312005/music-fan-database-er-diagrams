.5;fontColor=#000000;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="album" target="genre"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="815" /></Array><mxPoint x="-60" y="-14" as="offset" /></mxGeometry></mxCell><mxCell id="m_ga1" value="0..*" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1126" y="581" width="50" height="24" as="geometry" /></mxCell><mxCell id="m_ga2" value="0..*" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="856" y="821" width="50" height="24" as="geometry" /></mxCell><mxCell id="e_gb" value="has genre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="band" target="genre"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="192.5" /><mxPoint x="1310" y="900" /><mxPoint x="690" y="900" /></Array></mxGeometry></mxCell><mxCell id="m_gb1" value="0..*" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="198.5" width="50" height="24" as="geometry" /></mxCell><mxCell id="m_gb2" value="0..*" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=#FFFFFF;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="696" y="856" width="50" height="24" as="geometry" /></mxCell><mxCell id="note" value="Notation: underlined = primary key; FK = foreign key. Grey classes (BandMembership, SongContribution) resolve the many-to-many Musician–Band and Musician–Song relationships and hold the relationship attributes.&lt;br&gt;Assumptions: an album contains one or more songs; a song may be on zero albums (a single) or several (compilations, reissues). A solo act such as Lady Gaga is both a Band and a Musician." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="925" width="1180" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>